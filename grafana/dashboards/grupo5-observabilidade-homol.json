{
  "id": null,
  "uid": "grupo5-observabilidade-homol",
  "title": "Grupo 5 – Observabilidade HOMOL",
  "description": "Dashboard da A2 conforme o tutorial do Canvas, adaptado para Educação Continuada Gamificada. Spring Boot → Prometheus → Grafana.",
  "tags": [
    "grupo5",
    "a2",
    "homol",
    "canvas"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Status da API",
      "description": "1 = Prometheus consegue coletar as métricas da API; 0 = falha na coleta.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red"
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"grupo5-api\"}",
          "legendFormat": "Status",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Memória JVM – Heap",
      "description": "Memória heap utilizada pela JVM, apresentada em unidades IEC (MiB/GiB).",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"grupo5-api\",area=\"heap\"})",
          "legendFormat": "Heap utilizada",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Requisições HTTP",
      "description": "Taxa de requisições HTTP por segundo, calculada na janela de um minuto.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"grupo5-api\"}[1m]))",
          "legendFormat": "Requisições/s",
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Tempo Médio de Resposta",
      "description": "Tempo acumulado de processamento dividido pelo número de requisições na janela de um minuto.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"grupo5-api\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"grupo5-api\"}[1m]))",
          "legendFormat": "Tempo médio",
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
